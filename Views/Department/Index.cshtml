@model IEnumerable<SessionMVC850.Models.Department>

@{
    ViewData["Title"] = "Index";
    // Layout = "_TempLayout1";
    // Layout = null; //"_Layout850";
    //Layout = "_MYLayout1";
    Layout = "_NorLayout";

}



<h1>Department</h1>

<a href="http://localhost:5090/Department/Add">Add New Deparment</a>

@* <p>
    <a asp-action="Create">Create New</a>
</p> *@
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MangerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Code)
            </td>
            <td>
                @Html.DisplayFor(model => item.MangerName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Employees)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

