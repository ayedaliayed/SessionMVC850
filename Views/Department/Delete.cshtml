@model SessionMVC850.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<h2>Delete Department</h2>

<h3>Are you sure you want to delete this department?</h3>

<div class="card mb-4">
    <div class="card-header">
        @Model.Name
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>

            <dt class="col-sm-3">Manager Name</dt>
            <dd class="col-sm-9">@Model.MangerName</dd>
        </dl>
    </div>
</div>

@if (Model.Employees != null && Model.Employees.Count > 0)
{
    <div class="alert alert-warning">
        This department has @Model.Employees.Count employee(s). Deleting it will also delete them.
    </div>
}

<form action="/Department/SaveDelete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
